# Access mode. "public" = anyone with the link can view the archive.
# Anything else (or unset) = private, GitHub sign-in required (fail-closed).
APP_MODE=

# Private mode only — GitHub OAuth app credentials.
# Create one at https://github.com/settings/applications/new with callback URL:
#   https://<your-domain>/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Session cookie encryption key. Generate: `bunx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=

# Your GitHub username — the only account allowed to sign in.
ALLOWED_GITHUB_LOGIN=
