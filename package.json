{
    "name": "dormouse-template",
    "version": "0.4.0",
    "private": true,
    "scripts": {
        "prepare": "git config core.hooksPath .githooks || true",
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint:eslint": "eslint .",
        "lint:eslint:fix": "eslint . --fix",
        "lint:prettier": "prettier --check .",
        "lint:prettier:fix": "prettier --write .",
        "lint:stylelint": "stylelint \"**/*.{css,scss}\"",
        "lint:stylelint:fix": "stylelint \"**/*.{css,scss}\" --fix",
        "lint": "bun run lint:eslint && bun run lint:prettier && bun run lint:stylelint",
        "lint:fix": "bun run lint:eslint:fix && bun run lint:prettier:fix && bun run lint:stylelint:fix"
    },
    "dependencies": {
        "dequal": "2.0.3",
        "geist": "1.7.2",
        "next": "16.2.10",
        "next-auth": "5.0.0-beta.31",
        "next-intl": "4.13.2",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "server-only": "0.0.1"
    },
    "devDependencies": {
        "@antfu/eslint-config": "9.1.0",
        "@commitlint/cli": "21.2.1",
        "@commitlint/config-conventional": "21.2.0",
        "@eslint-react/eslint-plugin": "5.14.5",
        "@next/eslint-plugin-next": "16.2.10",
        "@types/bun": "1.3.14",
        "@types/node": "20.19.43",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "babel-plugin-react-compiler": "1.0.0",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-react-refresh": "0.5.3",
        "prettier": "3.9.5",
        "sass": "1.101.0",
        "stylelint": "17.14.0",
        "stylelint-config-prettier-scss": "1.0.0",
        "stylelint-config-recess-order": "7.7.0",
        "stylelint-config-standard-scss": "17.0.0",
        "typescript": "5.9.3"
    },
    "ignoreScripts": [
        "sharp",
        "unrs-resolver"
    ],
    "trustedDependencies": [
        "sharp",
        "unrs-resolver"
    ]
}
